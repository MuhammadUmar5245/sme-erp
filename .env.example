# Copy to .env and change every "change-me" value. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1
# Fernet key for field-level encryption at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me

POSTGRES_DB=sme_erp
POSTGRES_USER=sme_erp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Read-only PostgreSQL role used ONLY by Power BI (SELECT on schema "reporting").
POWERBI_READER_PASSWORD=change-me

TIME_ZONE=Asia/Muscat
# Host ports
HTTP_PORT=80
HTTPS_PORT=443
DB_HOST_PORT=5432
GUNICORN_WORKERS=3
