{
  "name": "SME-ERP Al Wadi",
  "dataColors": [
    "#0F4C5C", "#E36414", "#2A9D8F", "#E9C46A", "#5F0F40", "#9A031E",
    "#3A86FF", "#8D99AE", "#FB8B24", "#264653", "#6A994E", "#BC4749"
  ],
  "background": "#FFFFFF",
  "foreground": "#1D2B33",
  "tableAccent": "#0F4C5C",
  "good": "#2A9D8F",
  "neutral": "#E9C46A",
  "bad": "#C0392B",
  "maximum": "#0F4C5C",
  "center": "#E9C46A",
  "minimum": "#C0392B",
  "null": "#BFC5CA",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1D2B33" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0A3540" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0A3540" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#5B6770" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E8EB" } }, "radius": 6 }],
        "dropShadow": [{ "show": true, "preset": "BottomRight", "transparency": 85 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0A3540" } }, "fontSize": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F8" } }, "transparency": 0 }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "backColor": { "solid": { "color": "#0F4C5C" } }, "fontColor": { "solid": { "color": "#FFFFFF" } } }],
        "values": [{ "backColorSecondary": { "solid": { "color": "#F4F6F8" } } }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#0F4C5C" } } }]
      }
    }
  }
}
